# Scan2Tally Backend Environment Variables
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Operational quotas used by the in-app capacity monitor. These defaults match
# Supabase Free-plan project limits as of July 2026. Set 100 and 8192 for the
# included Pro/Team allowances, or use the limits agreed for your plan.
SUPABASE_STORAGE_QUOTA_GB=1
SUPABASE_DATABASE_QUOTA_MB=500
# Admin and Operator warnings begin here; the critical state becomes red.
SUPABASE_USAGE_WARNING_PERCENT=80
SUPABASE_USAGE_CRITICAL_PERCENT=95
# Shares one fresh aggregate between signed-in users to avoid repeated scans.
SUPABASE_CAPACITY_CACHE_SECONDS=25
# Server-owned publisher interval for Admin/Operator Realtime warning states.
# The alert rows change only when severity changes, so this does not broadcast
# a duplicate notification on every check.
SUPABASE_CAPACITY_ALERT_INTERVAL_SECONDS=30
# Which vision provider reads the vouchers: "openai" or "gemini". Defaults to
# "openai" when unset, so existing deployments keep working unchanged. Only
# the selected provider's API key needs to be valid; the other can be left as
# a placeholder or omitted.
AI_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key-here
GEMINI_API_KEY=your-google-gemini-vision-api-key
# Vision model used for voucher OCR. Defaults to gpt-5.5, which reads
# low-resolution / marginal vouchers noticeably better than gpt-4o.
OPENAI_VISION_MODEL=gpt-5.5
# Vision model used when AI_PROVIDER=gemini.
GEMINI_VISION_MODEL=gemini-3.6-flash
# Independent transcription passes per receipt. Cells the model cannot read
# reliably come back differently each pass and get flagged for review instead
# of being presented as fact. Passes run concurrently. Set to 1 to disable.
OCR_CONSENSUS_RUNS=3
# Output ceiling for one gpt-5.x vision request. Reasoning tokens are billed
# against this too and are spent BEFORE the JSON is written, so a ceiling that is
# merely close to the answer size returns an empty response, not a short one. A
# dense 11-row voucher measured 5,258 tokens (4,606 of them reasoning); the
# default leaves room for several times that. Ignored by gpt-4o.
OPENAI_MAX_COMPLETION_TOKENS=32000
# Output ceiling for one Gemini vision request. Ignored by OpenAI.
GEMINI_MAX_OUTPUT_TOKENS=8192
# Maximum wall time for each OpenAI/Gemini SDK request. OpenAI retries are off;
# the overall extraction deadline below still owns the whole receipt.
VISION_PROVIDER_TIMEOUT_SECONDS=300
# Longest edge of the image actually sent to the vision provider. A phone shoots
# a voucher at ~4000x3000, but both providers tile images into 768px blocks and
# downsample anything larger on arrival, so the extra pixels are uploaded and
# then discarded. 2200px across an A4 page is ~265 DPI, comfortably above where
# handwriting OCR degrades. Resized once per receipt and shared by all the
# concurrent passes. Set to 0 to send the image exactly as uploaded.
VISION_IMAGE_MAX_EDGE=2200
# JPEG quality for that resize. High on purpose: JPEG ringing around thin pen
# strokes is what turns a 3 into an 8. The saving comes from the resize, not
# from this, so there is nothing to gain by lowering it.
VISION_IMAGE_JPEG_QUALITY=90
# Durable global extraction queue (migration 007). Exactly one receipt is read
# platform-wide. Visibility is never allowed below the extraction deadline plus
# finalization margin, so the default 600 + 300 produces a 900-second lease.
EXTRACTION_QUEUE_POLL_SECONDS=2
# Prevent a briefly stale PostgREST schema cache from selecting legacy mode.
EXTRACTION_QUEUE_ABSENCE_GRACE_SECONDS=30
EXTRACTION_QUEUE_VISIBILITY_SECONDS=900
EXTRACTION_QUEUE_HEARTBEAT_SECONDS=30
EXTRACTION_QUEUE_MAX_ATTEMPTS=3
EXTRACTION_TIMEOUT_SECONDS=600
EXTRACTION_FINALIZATION_MARGIN_SECONDS=300
# Per-stage progress lines while a receipt is read: 0% claimed, 10% image
# downloaded, 15-70% vision responses as each lands, 75% consensus, 80%
# verified, 85% rows, 90% ledgers, 95% saving, 100% stored. Roughly a dozen
# lines per receipt. Set false to silence them on a host with a tight log
# budget; the extraction itself is unaffected either way.
EXTRACTION_PROGRESS_LOGS=true
PORT=8000
